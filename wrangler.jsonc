{
  "name": "whitworth-mvb",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "public" },
  "d1_databases": [
    { "binding": "DB", "database_name": "mvb-db", "database_id": "REPLACE_WITH_D1_DATABASE_ID" }
  ],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "mvb-photos" }],
  "vars": {
    "TEAM_DOMAIN": "REPLACE_WITH_TEAM.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE_WITH_ACCESS_APPLICATION_AUD_TAG"
  }
  // Custom domains: wire at deploy time, e.g.
  // "routes": [
  //   { "pattern": "whitworthmensvolleyball.com", "custom_domain": true },
  //   { "pattern": "www.whitworthmensvolleyball.com", "custom_domain": true }
  // ]
}
